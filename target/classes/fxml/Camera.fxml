
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.cmsc13.frontend.Camera"
    prefHeight="400.0"
    prefWidth="600.0"
    style="-fx-background-color: #f4f4f4;">

    <children>

        <!-- Camera preview area -->
        <Pane
            fx:id="cameraPane"
            layoutX="14.0"
            layoutY="14.0"
            prefHeight="341.0"
            prefWidth="574.0"
            AnchorPane.topAnchor="14.0"
            AnchorPane.leftAnchor="14.0"
            AnchorPane.rightAnchor="12.0"
            AnchorPane.bottomAnchor="45.0"
            style="-fx-border-color: black;
                   -fx-border-width: 2px;
                   -fx-background-color: black;" />

        <!-- Start recording -->
        <Button
            fx:id="recordButton"
            text="Record"
            mnemonicParsing="false"
            onAction="#handleRecord"
            layoutX="221.0"
            layoutY="361.0"
            AnchorPane.bottomAnchor="10.0"
            AnchorPane.leftAnchor="221.0" />

        <!-- Stop recording and save -->
        <Button
            fx:id="saveButton"
            text="Save"
            mnemonicParsing="false"
            onAction="#handleSave"
            layoutX="285.0"
            layoutY="361.0"
            AnchorPane.bottomAnchor="10.0"
            AnchorPane.leftAnchor="285.0" />

        <!-- Return to previous screen -->
        <Button
            fx:id="backButton"
            text="Back"
            mnemonicParsing="false"
            onAction="#handleBack"
            layoutX="347.0"
            layoutY="361.0"
            AnchorPane.bottomAnchor="10.0"
            AnchorPane.leftAnchor="347.0" />

    </children>
</AnchorPane>
