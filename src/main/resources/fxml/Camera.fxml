<?xml version="1.0" encoding="UTF-8"?>

<?import com.cmsc13.frontend.ui.NeonBackdrop?>
<?import com.cmsc13.frontend.ui.PixelText?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<!-- Public Humiliation Protocol: mockup 2.3 (webcam confession image) with a live camera feed -->
<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cmsc13.frontend.ConfessionController">
    <NeonBackdrop accent="#ff2a3c" prefWidth="1280" prefHeight="720"/>

    <!-- side info panels in the margins -->
    <VBox layoutX="10" layoutY="40" prefWidth="142" spacing="10">
        <PixelText bold="true" text="HR" pixel="3" fontSize="10" color="#ff5c6c" glow="#ff2a3c"/>
        <PixelText text="PROTOCOL" pixel="2" fontSize="9" color="#ff8a96"/>
        <Label fx:id="instructionLabel" styleClass="side-text" wrapText="true" prefWidth="142"/>
    </VBox>
    <VBox layoutX="1128" layoutY="40" prefWidth="142" spacing="10">
        <PixelText text="CASE" pixel="2" fontSize="9" color="#ff8a96"/>
        <Label fx:id="caseLabel" styleClass="side-text" wrapText="true" prefWidth="142"/>
        <Label fx:id="savedLabel" styleClass="side-text-ok" wrapText="true" prefWidth="142"/>
    </VBox>

    <!-- the 4:3 HUD frame, authored in the mockup's own 1080x809 coordinates and scaled to fit -->
    <Pane fx:id="frame" layoutX="100" layoutY="-44.5" prefWidth="1080" prefHeight="809" scaleX="0.89" scaleY="0.89">
        <Rectangle x="82" y="78" width="926" height="502" fill="#050508"/>
        <Canvas fx:id="noiseCanvas" layoutX="82" layoutY="78" width="926" height="502"/>
        <ImageView fx:id="cameraView" layoutX="82" layoutY="78" fitWidth="926" fitHeight="502"/>
        <Label fx:id="cameraStatus" layoutX="82" layoutY="300" prefWidth="926" alignment="CENTER"
               text="CONNECTING TO WEBCAM..." styleClass="camera-status"/>

        <ImageView fitWidth="1080" fitHeight="809">
            <image><Image url="@../images/confession_frame.png"/></image>
        </ImageView>

        <!-- HUD drawn over the feed (as in the mockup) -->
        <Circle fx:id="recDot" centerX="114" centerY="109" radius="10" fill="#ff2a3c">
            <effect><DropShadow color="#ff2a3c" radius="12"/></effect>
        </Circle>
        <PixelText bold="true" layoutX="134" layoutY="94" text="REC" pixel="3" fontSize="10" color="#ff4455" glow="#ff2a3c"/>
        <Pane fx:id="battery" layoutX="918" layoutY="94"/>
        <Pane fx:id="brackets" mouseTransparent="true"/>
        <PixelText bold="true" layoutX="100" layoutY="505" text="HD" pixel="3" fontSize="10" color="#ff4455" glow="#ff2a3c"/>
        <PixelText layoutX="100" layoutY="538" text="1080P" pixel="2" fontSize="10" color="#ff4455"/>
        <PixelText fx:id="timecode" layoutX="842" layoutY="524" text="00:00:00:00" pixel="2" fontSize="11" color="#ff4455" glow="#ff2a3c"/>

        <Circle fx:id="recRing" centerX="542" centerY="577" radius="54" fill="transparent" stroke="#ff2a3c" strokeWidth="4" opacity="0">
            <effect><DropShadow color="#ff2a3c" radius="20"/></effect>
        </Circle>

        <!-- confession line inside the bottom box -->
        <VBox layoutX="170" layoutY="648" prefWidth="760" prefHeight="104" alignment="CENTER" spacing="10" mouseTransparent="true">
            <HBox fx:id="line1" alignment="CENTER"/>
            <HBox fx:id="line2" alignment="CENTER"/>
        </VBox>

        <!-- the drawn STOP / REC / SNAPSHOT buttons -->
        <Button fx:id="stopButton" layoutX="338" layoutY="556" prefWidth="108" prefHeight="66"
                styleClass="hotspot, hotspot-red" onAction="#stop"/>
        <Button fx:id="recordButton" layoutX="492" layoutY="527" prefWidth="100" prefHeight="100"
                styleClass="hotspot, hotspot-red, hotspot-round" onAction="#record"/>
        <Button fx:id="snapshotButton" layoutX="634" layoutY="556" prefWidth="108" prefHeight="66"
                styleClass="hotspot, hotspot-red" onAction="#snapshot"/>

        <Rectangle fx:id="shutter" x="82" y="78" width="926" height="502" fill="white" opacity="0" mouseTransparent="true"/>
    </Pane>
</AnchorPane>
