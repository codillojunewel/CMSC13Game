<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1250.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cmsc13.frontend.Camera">

    <children>

        <!-- Camera preview area -->
        <Pane fx:id="cameraPane" layoutX="43.0" layoutY="29.0" prefHeight="547.0" prefWidth="1162.0" style="-fx-border-color: black;                    -fx-border-width: 2px;                    -fx-background-color: black;" AnchorPane.bottomAnchor="74.0" AnchorPane.leftAnchor="43.0" AnchorPane.rightAnchor="45.0" AnchorPane.topAnchor="29.0" />

        <!-- Start recording -->
        <Button fx:id="recordButton" layoutX="493.0" layoutY="588.0" mnemonicParsing="false" onAction="#handleRecord" text="Record" AnchorPane.bottomAnchor="23.0" AnchorPane.leftAnchor="493.0">
         <font>
            <Font size="18.0" />
         </font></Button>

        <!-- Return to previous screen -->
        <Button fx:id="backButton" layoutX="682.0" layoutY="590.0" mnemonicParsing="false" onAction="#handleBack" text="Back" AnchorPane.bottomAnchor="21.0" AnchorPane.leftAnchor="682.0">
         <font>
            <Font size="18.0" />
         </font></Button>

              <!-- Stop recording and save -->
        <Button fx:id="saveButton" layoutX="597.0" layoutY="589.0" mnemonicParsing="false" onAction="#handleSave" text="Save">
         <font>
            <Font size="18.0" />
         </font>
      </Button>

    </children>
</AnchorPane>
