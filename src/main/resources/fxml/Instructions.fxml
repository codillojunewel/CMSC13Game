<?xml version="1.0" encoding="UTF-8"?>

<?import com.cmsc13.frontend.ui.PixelText?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- How to Play: drawn inside the neon frame from the splash mockup -->
<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cmsc13.frontend.InstructionsController">
    <ImageView fitWidth="1280" fitHeight="720">
        <image><Image url="@../images/frame_bg.jpg"/></image>
    </ImageView>

    <HBox alignment="CENTER" layoutY="74" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <PixelText bold="true" text="HOW TO PLAY" pixel="4" fontSize="11" color="#ffffff" bottomColor="#9fd8ff" glow="#2f8cff"/>
    </HBox>

    <ScrollPane layoutX="205" layoutY="140" prefWidth="870" prefHeight="448" fitToWidth="true" hbarPolicy="NEVER" styleClass="frame-scroll">
        <VBox fx:id="content" spacing="12">
            <padding><Insets top="4" right="18" bottom="10" left="6"/></padding>
        </VBox>
    </ScrollPane>

    <HBox alignment="CENTER" layoutY="598" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <Button fx:id="backButton" styleClass="neon-btn, neon-btn-blue" onAction="#back">
            <graphic><PixelText bold="true" text="&lt; BACK" pixel="3" fontSize="9" color="#55b8ff"/></graphic>
        </Button>
    </HBox>
</AnchorPane>
