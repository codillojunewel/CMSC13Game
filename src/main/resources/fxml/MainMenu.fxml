<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<!-- Main menu: mockup 2.2 (first image). The buttons drawn in the artwork are made clickable. -->
<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cmsc13.frontend.MainMenuController">
    <ImageView fitWidth="1280" fitHeight="720">
        <image><Image url="@../images/menu_bg.jpg"/></image>
    </ImageView>

    <!-- blinking LEDs on the server rack -->
    <Pane fx:id="ledLayer" mouseTransparent="true"/>

    <Button fx:id="playButton" layoutX="457" layoutY="338" prefWidth="374" prefHeight="64"
            styleClass="hotspot, hotspot-green" onAction="#play"/>
    <Button layoutX="367" layoutY="420" prefWidth="247" prefHeight="61"
            styleClass="hotspot, hotspot-blue" onAction="#howToPlay"/>
    <Button layoutX="676" layoutY="420" prefWidth="241" prefHeight="61"
            styleClass="hotspot, hotspot-blue" onAction="#settings"/>
    <Button layoutX="552" layoutY="492" prefWidth="188" prefHeight="46"
            styleClass="hotspot, hotspot-red" onAction="#exit"/>

    <Label fx:id="statsLabel" styleClass="hud-caption" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
           AnchorPane.bottomAnchor="10" alignment="CENTER"/>
</AnchorPane>
